{
  "manifest_version": 3,
  "name": "ChatGPT Auto Allow Tool",
  "description": "Automatically clicks Korean/English allow buttons on ChatGPT tool permission cards.",
  "version": "0.2.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "ChatGPT Auto Allow Tool"
  }
}
